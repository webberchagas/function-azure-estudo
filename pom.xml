<?xml version="1.0" encoding="UTF-8"?><project xmlns="http://maven.apache.org/POM/4.0.0"         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0                             http://maven.apache.org/xsd/maven-4.0.0.xsd">    <modelVersion>4.0.0</modelVersion>    <groupId>com.example.fiap</groupId>    <artifactId>azf-webber-fiap</artifactId>    <version>1.0.0</version>    <packaging>jar</packaging>    <name>Azure Java Function</name>    <properties>        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>        <!-- Build deve ser determinístico -->        <java.version>17</java.version>        <!-- Plugins -->        <azure.functions.maven.plugin.version>1.34.0</azure.functions.maven.plugin.version>        <azure.functions.java.library.version>3.1.0</azure.functions.java.library.version>        <maven.compiler.release>${java.version}</maven.compiler.release>    </properties>    <dependencies>        <!-- Azure Functions Java SDK -->        <dependency>            <groupId>com.microsoft.azure.functions</groupId>            <artifactId>azure-functions-java-library</artifactId>            <version>${azure.functions.java.library.version}</version>        </dependency>        <!-- Testes -->        <dependency>            <groupId>org.junit.jupiter</groupId>            <artifactId>junit-jupiter</artifactId>            <version>5.10.1</version>            <scope>test</scope>        </dependency>        <dependency>            <groupId>org.mockito</groupId>            <artifactId>mockito-core</artifactId>            <version>5.8.0</version>            <scope>test</scope>        </dependency>    </dependencies>    <build>        <plugins>            <!-- Compiler -->            <plugin>                <groupId>org.apache.maven.plugins</groupId>                <artifactId>maven-compiler-plugin</artifactId>                <version>3.13.0</version>                <configuration>                    <release>${java.version}</release>                </configuration>            </plugin>            <!-- Azure Functions Maven Plugin -->            <!-- USADO APENAS PARA PACKAGE -->            <plugin>                <groupId>com.microsoft.azure</groupId>                <artifactId>azure-functions-maven-plugin</artifactId>                <version>${azure.functions.maven.plugin.version}</version>                <configuration>                    <!-- CI/CD moderno: nunca fazer deploy via Maven -->                    <skipDeploy>true</skipDeploy>                </configuration>                <executions>                    <execution>                        <id>package-functions</id>                        <goals>                            <goal>package</goal>                        </goals>                    </execution>                </executions>            </plugin>        </plugins>    </build></project>